<Window x:Class="CodexGuardian.App.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexGuardian.App"
        Title="{DynamicResource DashboardTitle}" Width="900" Height="700" MinWidth="820" MinHeight="640"
        WindowStartupLocation="CenterOwner" Background="#FF07090F" Foreground="#FFF4F7FF"
        FontFamily="Segoe UI Variable Text, Segoe UI" Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid Margin="30,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="{DynamicResource DashboardHeading}" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource DashboardSubtitle}" Foreground="#FF8C93A3" Margin="0,5,0,0" /></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="TaskButton" Content="{DynamicResource StartTask}" Padding="14,8" Margin="0,0,8,0" Click="TaskButton_Click" />
                <Button Content="{DynamicResource Refresh}" Padding="14,8" Click="RefreshButton_Click" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" Margin="0,24,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="#FF11141B" BorderBrush="#FF292E3A" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,10,0"><StackPanel><TextBlock Text="{DynamicResource FiveHourRemaining}" FontFamily="Cascadia Mono" FontSize="10" Foreground="#FF8C93A3" /><TextBlock x:Name="FiveHourValue" Text="—" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel></Border>
            <Border Grid.Column="1" Background="#FF11141B" BorderBrush="#FF292E3A" BorderThickness="1" CornerRadius="10" Padding="15" Margin="5,0"><StackPanel><TextBlock Text="{DynamicResource BurnRate}" FontFamily="Cascadia Mono" FontSize="10" Foreground="#FF8C93A3" /><TextBlock x:Name="BurnRateValue" Text="{DynamicResource Learning}" FontSize="20" FontWeight="SemiBold" Margin="0,9,0,0" /></StackPanel></Border>
            <Border Grid.Column="2" Background="#FF11141B" BorderBrush="#FF292E3A" BorderThickness="1" CornerRadius="10" Padding="15" Margin="10,0,0,0"><StackPanel><TextBlock Text="{DynamicResource Confidence}" FontFamily="Cascadia Mono" FontSize="10" Foreground="#FF8C93A3" /><TextBlock x:Name="ConfidenceValue" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,9,0,0" /></StackPanel></Border>
        </Grid>
        <local:QuotaTimelineControl x:Name="Timeline" Grid.Row="2" Focusable="True"
                                    SelectedTimeChanged="Timeline_SelectedTimeChanged"
                                    AutomationProperties.Name="{DynamicResource TimelineAutomationName}"
                                    AutomationProperties.HelpText="{DynamicResource TimelineAutomationHelp}" />
        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock x:Name="StatusText" Text="{DynamicResource LoadingHistory}" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="540" /><TextBlock x:Name="TrendText" Text="{DynamicResource LoadingTrends}" Foreground="#FF85D9C8" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" MaxWidth="540" /><TextBlock x:Name="BacktestText" Text="{DynamicResource LoadingReplay}" Foreground="#FF85D9C8" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" MaxWidth="540" /><TextBlock x:Name="StrategyText" Text="{DynamicResource LoadingReserve}" Foreground="#FFB8A6FF" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" MaxWidth="540" /><TextBlock x:Name="TaskText" Text="{DynamicResource LoadingTaskBudget}" Foreground="#FF9CA3B3" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" MaxWidth="540" /><TextBlock x:Name="WeeklyReportText" Text="{DynamicResource LoadingWeeklyReport}" Foreground="#FF747B8C" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" MaxWidth="540" /><TextBlock Text="{DynamicResource TimelineLegend}" Foreground="#FF747B8C" FontSize="11" Margin="0,3,0,0" /></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="CursorText" Text="{DynamicResource SelectTime}" Foreground="#FF8C93A3" VerticalAlignment="Center" Margin="0,0,12,0" /><Button Content="−" Width="30" Height="28" ToolTip="{DynamicResource ZoomOut}" Click="ZoomOutButton_Click" /><Button Content="+" Width="30" Height="28" Margin="4,0,12,0" ToolTip="{DynamicResource ZoomIn}" Click="ZoomInButton_Click" /><TextBlock Text="{DynamicResource Scenario}" Foreground="#FF8C93A3" VerticalAlignment="Center" Margin="0,0,10,0" /><ComboBox x:Name="Scenario" Width="150" SelectedIndex="2" SelectionChanged="Scenario_SelectionChanged"><ComboBoxItem Content="{DynamicResource ScenarioPaused}" Tag="Paused" /><ComboBoxItem Content="{DynamicResource ScenarioLight}" Tag="Light" /><ComboBoxItem Content="{DynamicResource ScenarioCurrent}" Tag="Current" /><ComboBoxItem Content="{DynamicResource ScenarioHigh}" Tag="High" /></ComboBox></StackPanel>
        </Grid>
    </Grid>
</Window>
