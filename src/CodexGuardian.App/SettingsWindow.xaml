<Window x:Class="CodexGuardian.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SettingsTitle}" Width="500" Height="720" MinHeight="620"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="#FFF4F7FF"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="SettingsSurface" Color="#FF11141B" />
        <SolidColorBrush x:Key="SettingsRaised" Color="#FF171B24" />
        <SolidColorBrush x:Key="SettingsHairline" Color="#FF292E3A" />
        <SolidColorBrush x:Key="SettingsMuted" Color="#FFA7ADBC" />
        <SolidColorBrush x:Key="SettingsAccent" Color="#FF7C83FF" />
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFE2E5ED" />
            <Setter Property="Margin" Value="0,8" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource SettingsRaised}" />
            <Setter Property="Foreground" Value="#FFF4F7FF" />
            <Setter Property="BorderBrush" Value="{StaticResource SettingsHairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid>
                    <ToggleButton x:Name="DropDownToggle" Focusable="False" Foreground="{TemplateBinding Foreground}" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                            <Border Background="{StaticResource SettingsRaised}" BorderBrush="{StaticResource SettingsHairline}" BorderThickness="1" CornerRadius="7" Padding="9,5">
                                <Grid><ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" TextElement.Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" /><Path Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource SettingsMuted}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,1,0" /></Grid>
                            </Border>
                        </ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                        <Border Background="{StaticResource SettingsRaised}" BorderBrush="{StaticResource SettingsHairline}" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}" Padding="4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsItemsHost="True" /></ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource SettingsRaised}" />
            <Setter Property="Foreground" Value="#FFF4F7FF" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemSurface" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" /></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#FF242936" /><Setter Property="Foreground" Value="#FFFFFFFF" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#FF20243A" /><Setter Property="Foreground" Value="#FFE5E7FF" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True" Maximum="{TemplateBinding Maximum}" Minimum="{TemplateBinding Minimum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                    <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" /></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#FF3A4050" CornerRadius="4" Margin="1" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" /></Track.IncreaseRepeatButton>
                </Track></Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#FF242936" />
            <Setter Property="BorderBrush" Value="{StaticResource SettingsHairline}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#FF303646" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource SettingsMuted}" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
    </Window.Resources>
    <Border Background="#FF07090F" BorderBrush="{StaticResource SettingsHairline}" BorderThickness="1" CornerRadius="18">
    <Grid Margin="22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <StackPanel><TextBlock Text="{DynamicResource SettingsTitle}" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource SettingsSubtitle}" Foreground="#FF8C93A3" Margin="0,5,0,0" /></StackPanel>
            <Button Content="×" HorizontalAlignment="Right" VerticalAlignment="Top" Width="30" Height="30" Padding="0" Click="CancelButton_Click" />
        </Grid>
        <Border Grid.Row="1" Margin="0,20,0,16" Background="{StaticResource SettingsSurface}" BorderBrush="{StaticResource SettingsHairline}" BorderThickness="1" CornerRadius="14" Padding="16,4,8,12">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="0,0,10,0">
            <TextBlock Text="{DynamicResource LanguageSection}" Style="{StaticResource SectionLabel}" Margin="0,8,0,0" />
            <Grid Margin="0,8,0,15">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource LanguageLabel}" VerticalAlignment="Center" />
                <ComboBox x:Name="LanguageCode" Grid.Column="1" SelectedValuePath="Tag">
                    <ComboBoxItem Content="{DynamicResource LanguageChinese}" Tag="zh-CN" />
                    <ComboBoxItem Content="{DynamicResource LanguageEnglish}" Tag="en-US" />
                </ComboBox>
            </Grid>
            <TextBlock Text="{DynamicResource RefreshSection}" Style="{StaticResource SectionLabel}" />
            <Grid Margin="0,8,0,15">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource RefreshInterval}" VerticalAlignment="Center" />
                <ComboBox x:Name="RefreshInterval" Grid.Column="1" SelectedValuePath="Tag">
                    <ComboBoxItem Content="{DynamicResource Seconds15}" Tag="15" /><ComboBoxItem Content="{DynamicResource Seconds30}" Tag="30" />
                    <ComboBoxItem Content="{DynamicResource Minute1}" Tag="60" /><ComboBoxItem Content="{DynamicResource Minutes5}" Tag="300" />
                </ComboBox>
            </Grid>
            <TextBlock Text="{DynamicResource BehaviorSection}" Style="{StaticResource SectionLabel}" />
            <CheckBox x:Name="AlwaysOnTop" Content="{DynamicResource AlwaysOnTop}" />
            <CheckBox x:Name="StartWithWindows" Content="{DynamicResource StartWithWindows}" Click="StartupMode_Changed" />
            <CheckBox x:Name="FollowCodex" Content="{DynamicResource FollowCodex}" Click="StartupMode_Changed" />
            <TextBlock Text="{DynamicResource FollowCodexSubtitle}" Foreground="#FF8C93A3" FontSize="10" Margin="24,-4,0,6" TextWrapping="Wrap" />
            <CheckBox x:Name="ReduceMotion" Content="{DynamicResource ReduceMotion}" Click="PreviewSetting_Changed" />
            <CheckBox x:Name="LowPresenceMode" Content="{DynamicResource LowPresenceMode}" Click="PreviewSetting_Changed" />
            <Grid Margin="0,7,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Theme}" VerticalAlignment="Center" />
                <ComboBox x:Name="ThemeMode" Grid.Column="1" SelectedValuePath="Tag" SelectionChanged="PreviewSetting_Changed">
                    <ComboBoxItem Content="{DynamicResource ThemeMinimal}" Tag="MinimalDark" /><ComboBoxItem Content="{DynamicResource ThemeGlass}" Tag="Glass" />
                    <ComboBoxItem Content="{DynamicResource ThemeCyber}" Tag="Cyber" /><ComboBoxItem Content="{DynamicResource ThemeEmber}" Tag="Ember" />
                    <ComboBoxItem Content="{DynamicResource ThemeAurora}" Tag="Aurora" /><ComboBoxItem Content="{DynamicResource ThemeMoss}" Tag="Moss" />
                    <ComboBoxItem Content="{DynamicResource ThemeSakura}" Tag="Sakura" /><ComboBoxItem Content="{DynamicResource ThemeFrost}" Tag="Frost" />
                    <ComboBoxItem Content="{DynamicResource ThemeTidal}" Tag="Tidal" /><ComboBoxItem Content="{DynamicResource ThemeSolar}" Tag="Solar" />
                </ComboBox>
            </Grid>
            <Grid Margin="0,8,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="{DynamicResource AmbientEffect}" /><TextBlock Text="{DynamicResource AmbientEffectSubtitle}" Foreground="#FF8C93A3" FontSize="10" /></StackPanel>
                <ComboBox x:Name="AmbientEffectMode" Grid.Column="1" SelectedValuePath="Tag" SelectionChanged="PreviewSetting_Changed">
                    <ComboBoxItem Content="{DynamicResource EffectNone}" Tag="None" /><ComboBoxItem Content="{DynamicResource EffectPetals}" Tag="Petals" />
                    <ComboBoxItem Content="{DynamicResource EffectSnow}" Tag="Snow" /><ComboBoxItem Content="{DynamicResource EffectFireflies}" Tag="Fireflies" />
                    <ComboBoxItem Content="{DynamicResource EffectStarfall}" Tag="Starfall" />
                </ComboBox>
            </Grid>
            <Border x:Name="ThemePreviewSurface" Height="76" CornerRadius="12" BorderThickness="1" Margin="0,8,0,0" ClipToBounds="True">
                <Grid>
                    <Canvas x:Name="ThemePreviewEffects" IsHitTestVisible="False" />
                    <Grid Margin="13,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="ThemePreviewAccent" Width="9" Height="9" Margin="0,0,8,0" />
                            <StackPanel><TextBlock Text="{DynamicResource PreviewGuardian}" Foreground="#FFF2F4F8" FontFamily="Cascadia Mono, Consolas" FontSize="9" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource PreviewLive}" Foreground="#FF8C93A3" FontFamily="Cascadia Mono, Consolas" FontSize="7" Margin="0,3,0,0" /></StackPanel>
                        </StackPanel>
                        <Grid Grid.Column="1" Margin="8,2,16,2">
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource FiveHourCompactLabel}" Foreground="#FFA5ABB8" FontFamily="Cascadia Mono, Consolas" FontSize="8" VerticalAlignment="Center" /><Border x:Name="ThemePreviewPrimaryTrack" Grid.Column="1" Height="5" CornerRadius="3" VerticalAlignment="Center"><Border x:Name="ThemePreviewPrimaryFill" Width="86" CornerRadius="3" HorizontalAlignment="Left" /></Border></Grid>
                            <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource WeeklyCompactLabel}" Foreground="#FFA5ABB8" FontFamily="Cascadia Mono, Consolas" FontSize="8" VerticalAlignment="Center" /><Border x:Name="ThemePreviewSecondaryTrack" Grid.Column="1" Height="5" CornerRadius="3" VerticalAlignment="Center"><Border x:Name="ThemePreviewSecondaryFill" Width="51" CornerRadius="3" HorizontalAlignment="Left" /></Border></Grid>
                        </Grid>
                        <Border x:Name="ThemePreviewChip" Grid.Column="2" CornerRadius="6" Padding="8,4" VerticalAlignment="Center"><TextBlock x:Name="ThemePreviewPrimary" Text="68%" FontFamily="Cascadia Mono, Consolas" FontSize="11" FontWeight="SemiBold" /></Border>
                    </Grid>
                </Grid>
            </Border>
            <Border Background="#FF151923" BorderBrush="{StaticResource SettingsHairline}" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,8,0,0">
                <TextBlock Text="{DynamicResource ThemePreviewHint}" Foreground="#FF9CA3B3" FontSize="10" TextWrapping="Wrap" />
            </Border>
            <Grid Margin="0,8,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="{DynamicResource QuotaStrategy}" /><TextBlock Text="{DynamicResource StrategySubtitle}" Foreground="#FF8C93A3" FontSize="10" /></StackPanel>
                <ComboBox x:Name="StrategyMode" Grid.Column="1" SelectedValuePath="Tag">
                    <ComboBoxItem Content="{DynamicResource StrategySprint}" Tag="Sprint" /><ComboBoxItem Content="{DynamicResource StrategyBalanced}" Tag="Balanced" />
                    <ComboBoxItem Content="{DynamicResource StrategyConservative}" Tag="Conservative" />
                </ComboBox>
            </Grid>
            <TextBlock Text="{DynamicResource NotificationsSection}" Style="{StaticResource SectionLabel}" />
            <CheckBox x:Name="EnableNotifications" Content="{DynamicResource EnableNotifications}" />
            <CheckBox x:Name="DoNotDisturb" Content="{DynamicResource DoNotDisturb}" />
            <Button Content="{DynamicResource TestNotification}" Margin="0,7,0,0" HorizontalAlignment="Left" Click="TestNotificationButton_Click" />
            <TextBlock x:Name="NotificationTestStatus" Foreground="#FF85D9C8" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
            <Border Background="#FF151923" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                <TextBlock Text="{DynamicResource NotificationExplanation}"
                           Foreground="#FF9CA3B3" FontSize="11" TextWrapping="Wrap" />
            </Border>
            <TextBlock Text="{DynamicResource LocalDataSection}" Style="{StaticResource SectionLabel}" />
            <TextBlock Text="{DynamicResource HistoryPrivacy}" Foreground="#FF9CA3B3" FontSize="11" Margin="0,6,0,8" />
            <CheckBox x:Name="EnablePersonalizedAnalysis" Content="{DynamicResource EnablePersonalizedAnalysis}" />
            <Grid Margin="0,0,0,9">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource HistoryRetention}" VerticalAlignment="Center" />
                <ComboBox x:Name="HistoryRetention" Grid.Column="1" SelectedValuePath="Tag">
                    <ComboBoxItem Content="{DynamicResource Days30}" Tag="30" /><ComboBoxItem Content="{DynamicResource Days90}" Tag="90" />
                    <ComboBoxItem Content="{DynamicResource Days180}" Tag="180" /><ComboBoxItem Content="{DynamicResource Year1}" Tag="365" />
                </ComboBox>
            </Grid>
            <StackPanel Orientation="Horizontal">
                <Button Content="{DynamicResource ExportSummary}" Margin="0" Click="ExportHistoryButton_Click" />
                <Button Content="{DynamicResource ClearHistory}" Click="ClearHistoryButton_Click" />
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource Cancel}" Click="CancelButton_Click" />
            <Button Content="{DynamicResource SaveChanges}" Background="{StaticResource SettingsAccent}" BorderBrush="{StaticResource SettingsAccent}" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
    </Border>
</Window>
