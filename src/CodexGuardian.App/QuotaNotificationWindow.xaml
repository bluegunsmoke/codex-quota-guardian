<Window x:Class="CodexGuardian.App.QuotaNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource NotificationTitle}" Width="390" Height="170"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True" Background="Transparent"
        AllowsTransparency="True" Loaded="Window_Loaded">
    <Border Background="#FA10131B" BorderBrush="#FF464D61" BorderThickness="1" CornerRadius="14" Padding="18">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#FFB8A6FF" Margin="0,0,9,0" /><TextBlock Text="{DynamicResource NotificationBrand}" Foreground="#FFB8A6FF" FontFamily="Cascadia Mono, Consolas" FontSize="10" FontWeight="SemiBold" /></StackPanel>
                <Button Grid.Column="1" Content="×" Width="24" Height="24" Background="Transparent" Foreground="#FFA7ADBC" BorderThickness="0" Click="DismissButton_Click" />
            </Grid>
            <TextBlock x:Name="MessageText" Grid.Row="1" Foreground="#FFF4F7FF" FontSize="14" TextWrapping="Wrap" Margin="0,10,0,12" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource SilenceUntilReset}" Padding="12,7" Margin="0,0,8,0" Click="SilenceButton_Click" />
                <Button Content="{DynamicResource ViewTimeline}" Padding="12,7" Background="#FF686FF0" Foreground="White" Click="ViewButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
